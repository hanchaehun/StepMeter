# Shared local M2/browser/test runtime. API and agent implementations belong to their owners.
FROM node:22-bookworm-slim AS collect
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY worker/collect/src worker/collect/src
RUN npm run build:collect

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /app
COPY requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt \
    && python -m playwright install --with-deps chromium \
    && useradd --create-home --uid 10001 stepmeter
COPY worker worker
COPY tests tests
# Evaluation tests import this module; do not copy private holdouts or evidence.
COPY benchmark/eval.py benchmark/eval.py
COPY infra/scripts infra/scripts
COPY prompts prompts
COPY apps/api apps/api
COPY --from=collect /build/worker/collect/dist worker/collect/dist
COPY --from=collect /build/node_modules/axe-core/axe.min.js node_modules/axe-core/axe.min.js
RUN mkdir -p /app/data/screenshots && chown -R stepmeter:stepmeter /app/data
USER stepmeter
CMD ["python", "-m", "unittest", "discover", "-s", "tests", "-v"]
