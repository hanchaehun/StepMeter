# 이 파일을 .env로 복사해서 값을 채운다. .env는 커밋되지 않는다 (협업 규칙 5번).
# Claude Console(Stepmeter 조직)에서 받은 키
ANTHROPIC_API_KEY=

# 가짜 LLM 모드 (worker/llm/README.md). 크레딧 없이 E2E를 돌릴 때만 켠다.
# STEPMETER_LLM=fake
# STEPMETER_FAKE_REPLIES=tests/fixtures/e2e/signup/fake_replies.json

# M2 Compose (infra/m2.md): API 담당자가 제공한 명령. 0.0.0.0:8000에 수신해야 한다.
# STEPMETER_API_COMMAND=
# API_PORT=8000
# STEPMETER_ACCESS_CODE=
# m2 프로필의 worker는 로컬 E2E 전용 fake 모드다. 실제 키를 이 파일에 넣지 않는다.
